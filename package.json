{
	"name": "kasugai-ssh",
	"displayName": "Kasugai — Remote SSH",
	"description": "Stable and fast SSH remote development for VSCodium and VS Code. Keeps your session alive through network drops and reconnects automatically.",
	"version": "0.1.0",
	"author": {
		"name": "moriyama-dev",
		"url": "https://github.com/moriyama-dev"
	},
	"publisher": "moriyama-dev",
	"license": "MIT",
	"homepage": "https://github.com/moriyama-dev/kasugai",
	"repository": {
		"type": "git",
		"url": "https://github.com/moriyama-dev/kasugai.git"
	},
	"bugs": {
		"url": "https://github.com/moriyama-dev/kasugai/issues"
	},
	"engines": {
		"vscode": "^1.70.2"
	},
	"main": "./lib/extension.js",
	"browser": "./lib/extension.js",
	"scripts": {
		"audit": "better-npm-audit audit",
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "webpack --mode production",
		"bundle:dev": "webpack --mode development",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf --glob lib out '*.vsix' .test",
		"compile:src": "tsc -b",
		"compile:test": "tsc -p test",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm run audit && npm run ci:lint && npm run lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"package": "rimraf --glob '*.vsix' && vsce package",
		"postinstall": "npm run update:dts",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"test": "vitest run --reporter tree",
		"test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
		"test:images": "bash ./dockerfiles/build.sh",
		"test:ui": "vitest --ui --coverage",
		"test:watch": "vitest",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all",
		"update:dts": "npx vscode-dts dev && npx vscode-dts main",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p . --onSuccess 'npm run bundle:dev'",
		"watch:test": "tsc-watch -p test"
	},
	"dependencies": {
		"@zokugun/is-it-type": "0.8.1",
		"glob": "13.0.6",
		"semver": "7.8.5",
		"simple-socks": "3.6.0",
		"socks": "2.8.10",
		"ssh-config": "5.3.0",
		"ssh2": "git+https://github.com/jeanp413/ssh2#master"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "20.19.43",
		"@types/semver": "7.8.0",
		"@types/ssh2": "0.5.52",
		"@types/ssh2-streams": "0.1.13",
		"@types/webpack": "5.28.5",
		"@typescript-eslint/eslint-plugin": "8.71.2",
		"@typescript-eslint/parser": "8.71.2",
		"@vitest/coverage-v8": "4.1.12",
		"@vitest/ui": "4.1.12",
		"@vscode/vsce": "3.9.2",
		"@zokugun/fs-extra-plus": "0.5.0",
		"@zokugun/xtry": "0.11.6",
		"better-npm-audit": "3.11.0",
		"eslint": "10.12.0",
		"eslint-plugin-jsdoc": "62.9.0",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"memfs": "4.80.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.17.2",
		"ts-loader": "9.6.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2",
		"universalify": "2.0.1",
		"vitest": "4.1.12",
		"webpack": "5.112.0",
		"webpack-cli": "7.2.3",
		"yaml": "2.9.1"
	},
	"activationEvents": [
		"onCommand:kasugai.openEmptyWindow",
		"onCommand:kasugai.openEmptyWindowInCurrentWindow",
		"onCommand:kasugai.openConfigFile",
		"onCommand:kasugai.showLog",
		"onResolveRemoteAuthority:kasugai-ssh",
		"onView:kasugaiHosts"
	],
	"contributes": {
		"configuration": {
			"title": "Kasugai",
			"properties": {
				"kasugai.configFile": {
					"type": "string",
					"description": "The absolute file path to a custom SSH config file.",
					"default": "",
					"scope": "application"
				},
				"kasugai.connectTimeout": {
					"type": "number",
					"description": "Specifies the timeout in seconds used for the SSH command that connects to the remote.",
					"default": 60,
					"scope": "application",
					"minimum": 1
				},
				"kasugai.verifyUnknownHosts": {
					"type": "string",
					"enum": [
						"accept",
						"ask",
						"reject"
					],
					"enumDescriptions": [
						"Add the key to known_hosts and connect, like OpenSSH's `accept-new`.",
						"Show the key fingerprint and ask before connecting.",
						"Refuse to connect."
					],
					"description": "What to do when a host is not present in known_hosts.",
					"default": "ask",
					"scope": "application"
				},
				"kasugai.verifyKnownHosts": {
					"type": "string",
					"enum": [
						"accept",
						"ask",
						"reject"
					],
					"enumDescriptions": [
						"Connect without asking. The recorded key is left untouched.",
						"Show both fingerprints and ask before connecting.",
						"Refuse to connect, like OpenSSH's `strict`."
					],
					"description": "What to do when a host presents a different key than the one recorded in known_hosts. A changed host key can mean the server was reinstalled — or that the connection is being intercepted.",
					"default": "reject",
					"scope": "application"
				},
				"kasugai.defaultExtensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "List of extensions that should be installed automatically on all SSH hosts.",
					"scope": "application"
				},
				"kasugai.enableDynamicForwarding": {
					"type": "boolean",
					"description": "Whether to use SSH dynamic forwarding to allow setting up new port tunnels over an existing SSH connection.",
					"scope": "application",
					"default": true
				},
				"kasugai.enableAgentForwarding": {
					"type": "boolean",
					"markdownDescription": "Enable fixing the remote environment so that the SSH config option `ForwardAgent` will take effect as expected from VS Code's remote extension host.",
					"scope": "application",
					"default": true
				},
				"kasugai.serverDownloadUrlTemplate": {
					"type": "string",
					"description": "The URL from where the vscode server will be downloaded. You can use the following variables and they will be replaced dynamically:\n- ${quality}: vscode server quality, e.g. stable or insiders\n- ${version}: vscode server version, e.g. 1.69.0\n- ${commit}: vscode server release commit\n- ${arch}: vscode server arch, e.g. x64, armhf, arm64\n- ${release}: release number, vscodium only https://github.com/VSCodium/vscodium/pull/1192",
					"scope": "application"
				},
				"kasugai.remotePlatform": {
					"type": "object",
					"description": "A map of the remote hostname to the platform for that remote. Valid values: linux, macos, windows.",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "string",
						"enum": [
							"linux",
							"macos",
							"windows"
						]
					}
				},
				"kasugai.remoteServerListenOnSocket": {
					"type": "boolean",
					"description": "When true, the remote vscode server will listen on a socket path instead of opening a port. Only valid for Linux and macOS remotes. Requires `AllowStreamLocalForwarding` to be enabled for the SSH server.",
					"default": false
				},
				"kasugai.serverInstallPath": {
					"type": "object",
					"description": "Specifies custom installation directories for the VS Code server on remote hosts. Maps each remote hostname (or pattern) to an absolute path where the server should be installed. Supports wildcards: use `*` for catch-all, or `*.domain.com` for domain-specific paths. More specific patterns take precedence over general ones. When not specified, the server installs in the default home directory. **Note**: Changing this setting may require manual cleanup of existing server installations in previous locations.",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "string"
					}
				},
				"kasugai.serverBinaryName": {
					"type": "string",
					"description": "The name of the server binary, use this **only if** you are using a client without a corresponding server release",
					"scope": "application",
					"default": ""
				},
				"kasugai.serverVersion": {
					"type": "string",
					"description": "The version number of the remote VSCodium server. Can take the values: 'match' (default), 'latest', 'closest' or a specific version (e.g. '1.117.0').",
					"scope": "application",
					"default": "match"
				},
				"kasugai.serverValidation": {
					"type": "string",
					"description": "Type of server validation: 'strict' (default) enforces that the remote and local server are the same version by matching the commit, 'force' modifies the remote commit to match the local server, 'skip' skips validation all together.",
					"scope": "application",
					"default": "strict",
					"enum": [
						"force",
						"skip",
						"strict"
					],
					"enumDescriptions": [
						"Modify the commit of the remote server.",
						"The remote server won't validate the client.",
						"The remote server and client's commits must match. (default)"
					]
				}
			}
		},
		"views": {
			"remote": [
				{
					"id": "kasugaiHosts",
					"name": "SSH Targets (Kasugai)",
					"group": "targets@1",
					"remoteName": "kasugai-ssh"
				}
			]
		},
		"commands": [
			{
				"command": "kasugai.openEmptyWindow",
				"title": "Connect to Host...",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.openEmptyWindowInCurrentWindow",
				"title": "Connect Current Window to Host...",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.openConfigFile",
				"title": "Open SSH Configuration File...",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.showLog",
				"title": "Show Log",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.explorer.emptyWindowInNewWindow",
				"title": "Connect to Host in New Window",
				"icon": "$(empty-window)"
			},
			{
				"command": "kasugai.explorer.emptyWindowInCurrentWindow",
				"title": "Connect to Host in Current Window",
				"icon": "$(arrow-right)"
			},
			{
				"command": "kasugai.explorer.reopenFolderInCurrentWindow",
				"title": "Open on SSH Host in Current Window",
				"icon": "$(arrow-right)"
			},
			{
				"command": "kasugai.explorer.reopenFolderInNewWindow",
				"title": "Open on SSH Host in New Window",
				"icon": "$(folder-opened)"
			},
			{
				"command": "kasugai.explorer.deleteFolderHistoryItem",
				"title": "Remove From Recent List",
				"icon": "$(x)"
			},
			{
				"command": "kasugai.explorer.refresh",
				"title": "Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "kasugai.explorer.configure",
				"title": "Configure",
				"icon": "$(gear)"
			},
			{
				"command": "kasugai.explorer.add",
				"title": "Add New",
				"icon": "$(plus)"
			}
		],
		"resourceLabelFormatters": [
			{
				"scheme": "vscode-remote",
				"authority": "kasugai-ssh+*",
				"formatting": {
					"label": "${path}",
					"separator": "/",
					"tildify": true,
					"workspaceSuffix": "SSH"
				}
			}
		],
		"menus": {
			"statusBar/remoteIndicator": [
				{
					"command": "kasugai.openEmptyWindow",
					"when": "remoteName =~ /^kasugai-ssh$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@1"
				},
				{
					"command": "kasugai.openEmptyWindowInCurrentWindow",
					"when": "remoteName =~ /^kasugai-ssh$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@2"
				},
				{
					"command": "kasugai.openConfigFile",
					"when": "remoteName =~ /^kasugai-ssh$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@3"
				},
				{
					"command": "kasugai.showLog",
					"when": "remoteName =~ /^kasugai-ssh$/ && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@4"
				},
				{
					"command": "kasugai.openEmptyWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@1"
				},
				{
					"command": "kasugai.openEmptyWindowInCurrentWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@2"
				},
				{
					"command": "kasugai.openConfigFile",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@3"
				},
				{
					"command": "kasugai.openEmptyWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@5"
				},
				{
					"command": "kasugai.openEmptyWindowInCurrentWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@6"
				},
				{
					"command": "kasugai.openConfigFile",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@7"
				}
			],
			"commandPalette": [
				{
					"command": "kasugai.explorer.refresh",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.configure",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.add",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.emptyWindowInNewWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.emptyWindowInCurrentWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.reopenFolderInCurrentWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.reopenFolderInNewWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.deleteFolderHistoryItem",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "kasugai.explorer.add",
					"when": "view == kasugaiHosts",
					"group": "navigation"
				},
				{
					"command": "kasugai.explorer.configure",
					"when": "view == kasugaiHosts",
					"group": "navigation"
				},
				{
					"command": "kasugai.explorer.refresh",
					"when": "view == kasugaiHosts",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "kasugai.explorer.emptyWindowInCurrentWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.emptyWindowInNewWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.emptyWindowInNewWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "navigation@2"
				},
				{
					"command": "kasugai.explorer.emptyWindowInCurrentWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "navigation@1"
				},
				{
					"command": "kasugai.explorer.reopenFolderInCurrentWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.reopenFolderInNewWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.reopenFolderInNewWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "navigation@2"
				},
				{
					"command": "kasugai.explorer.reopenFolderInCurrentWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "navigation@1"
				},
				{
					"command": "kasugai.explorer.deleteFolderHistoryItem",
					"when": "viewItem =~ /^kasugai.explorer.folder/",
					"group": "navigation@3"
				},
				{
					"command": "kasugai.explorer.deleteFolderHistoryItem",
					"when": "viewItem =~ /^kasugai.explorer.folder/",
					"group": "inline@2"
				}
			]
		}
	},
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"overrides": {
		"@azure/identity": {
			"@azure/msal-node": "7.1.1"
		},
		"@octokit/request": {
			"content-type": "2.1.0"
		},
		"get-uri": {
			"basic-ftp": "6.2.3"
		},
		"magicast": {
			"source-map-js": "1.2.2"
		},
		"postcss": {
			"source-map-js": "1.2.2"
		},
		"release-it": {
			"undici": "7.30.1"
		}
	},
	"allowScripts": {
		"fsevents": true
	},
	"keywords": [
		"kasugai",
		"reconnect",
		"remote",
		"remote development",
		"ssh",
		"vscodium"
	],
	"api": "none",
	"enabledApiProposals": [
		"resolvers",
		"contribViewsRemote"
	],
	"extensionKind": [
		"ui"
	]
}
