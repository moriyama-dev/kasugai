{
	"name": "kasugai-ssh",
	"displayName": "Kasugai — Remote SSH",
	"description": "%description%",
	"version": "0.3.0",
	"author": {
		"name": "moriyama-dev",
		"url": "https://github.com/moriyama-dev"
	},
	"publisher": "moriyama-dev",
	"license": "MIT",
	"homepage": "https://github.com/moriyama-dev/kasugai",
	"repository": {
		"type": "git",
		"url": "https://github.com/moriyama-dev/kasugai.git"
	},
	"bugs": {
		"url": "https://github.com/moriyama-dev/kasugai/issues"
	},
	"engines": {
		"vscode": "^1.70.2"
	},
	"main": "./lib/extension.js",
	"browser": "./lib/extension.js",
	"scripts": {
		"audit": "better-npm-audit audit",
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "webpack --mode production",
		"bundle:dev": "webpack --mode development",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf --glob lib out '*.vsix' .test",
		"compile:src": "tsc -b",
		"compile:test": "tsc -p test",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm run audit && npm run ci:lint && npm run lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"notices": "node scripts/third-party-notices.mjs",
		"package": "rimraf --glob '*.vsix' && vsce package",
		"package:release": "bash scripts/package-release.sh",
		"postinstall": "npm run update:dts",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"test": "vitest run --reporter tree",
		"test:coverage": "vitest run --reporter tree --coverage --coverage.reporter text",
		"test:images": "bash ./dockerfiles/build.sh",
		"test:startup": "node test-startup/run.mjs",
		"test:ui": "vitest --ui --coverage",
		"test:watch": "vitest",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all",
		"update:dts": "npx vscode-dts dev && npx vscode-dts main",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p . --onSuccess 'npm run bundle:dev'",
		"watch:test": "tsc-watch -p test"
	},
	"dependencies": {
		"@zokugun/is-it-type": "0.8.1",
		"glob": "13.0.6",
		"jsonc-parser": "3.3.1",
		"semver": "7.8.5",
		"socks": "2.8.10",
		"ssh-config": "5.3.0",
		"ssh2": "git+https://github.com/jeanp413/ssh2#master"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "20.19.43",
		"@types/semver": "7.8.0",
		"@types/ssh2": "0.5.52",
		"@types/ssh2-streams": "0.1.13",
		"@types/webpack": "5.28.5",
		"@typescript-eslint/eslint-plugin": "8.71.2",
		"@typescript-eslint/parser": "8.71.2",
		"@vitest/coverage-v8": "4.1.12",
		"@vitest/ui": "4.1.12",
		"@vscode/test-electron": "3.1.0",
		"@vscode/vsce": "3.9.2",
		"@zokugun/fs-extra-plus": "0.5.0",
		"@zokugun/xtry": "0.11.6",
		"better-npm-audit": "3.11.0",
		"eslint": "10.12.0",
		"eslint-plugin-jsdoc": "62.9.0",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"memfs": "4.80.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.17.2",
		"ts-loader": "9.6.2",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2",
		"universalify": "2.0.1",
		"vitest": "4.1.12",
		"webpack": "5.112.0",
		"webpack-cli": "7.2.3",
		"yaml": "2.9.1"
	},
	"activationEvents": [
		"onCommand:kasugai.openEmptyWindow",
		"onCommand:kasugai.openEmptyWindowInCurrentWindow",
		"onCommand:kasugai.openConfigFile",
		"onCommand:kasugai.showLog",
		"onResolveRemoteAuthority:kasugai-ssh",
		"onResolveRemoteAuthority:ssh-remote",
		"onView:kasugaiHosts",
		"onView:kasugaiFeedback"
	],
	"contributes": {
		"configuration": {
			"title": "Kasugai",
			"properties": {
				"kasugai.configFile": {
					"type": "string",
					"description": "%config.configFile%",
					"default": "",
					"scope": "application"
				},
				"kasugai.connectTimeout": {
					"type": "number",
					"description": "%config.connectTimeout%",
					"default": 60,
					"scope": "application",
					"minimum": 1
				},
				"kasugai.keepAliveInterval": {
					"type": "number",
					"default": 15,
					"minimum": 0,
					"scope": "application",
					"markdownDescription": "%config.keepAliveInterval%"
				},
				"kasugai.keepAliveCountMax": {
					"type": "number",
					"default": 3,
					"minimum": 1,
					"scope": "application",
					"markdownDescription": "%config.keepAliveCountMax%"
				},
				"kasugai.reconnectTimeout": {
					"type": "number",
					"default": 3600,
					"minimum": 0,
					"scope": "application",
					"markdownDescription": "%config.reconnectTimeout%"
				},
				"kasugai.verifyUnknownHosts": {
					"type": "string",
					"enum": [
						"accept",
						"ask",
						"reject"
					],
					"enumDescriptions": [
						"%config.verifyUnknownHosts.accept%",
						"%config.verifyUnknownHosts.ask%",
						"%config.verifyUnknownHosts.reject%"
					],
					"description": "%config.verifyUnknownHosts%",
					"default": "ask",
					"scope": "application"
				},
				"kasugai.verifyKnownHosts": {
					"type": "string",
					"enum": [
						"accept",
						"ask",
						"reject"
					],
					"enumDescriptions": [
						"%config.verifyKnownHosts.accept%",
						"%config.verifyKnownHosts.ask%",
						"%config.verifyKnownHosts.reject%"
					],
					"description": "%config.verifyKnownHosts%",
					"default": "reject",
					"scope": "application"
				},
				"kasugai.defaultExtensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "%config.defaultExtensions%",
					"scope": "application"
				},
				"kasugai.enableDynamicForwarding": {
					"type": "boolean",
					"description": "%config.enableDynamicForwarding%",
					"scope": "application",
					"default": true
				},
				"kasugai.enableAgentForwarding": {
					"type": "boolean",
					"markdownDescription": "%config.enableAgentForwarding%",
					"scope": "application",
					"default": true
				},
				"kasugai.serverDownloadUrlTemplate": {
					"type": "string",
					"description": "%config.serverDownloadUrlTemplate%",
					"scope": "application"
				},
				"kasugai.localServerDownload": {
					"type": "string",
					"enum": [
						"auto",
						"always",
						"off"
					],
					"default": "auto",
					"scope": "application",
					"enumDescriptions": [
						"%config.localServerDownload.auto%",
						"%config.localServerDownload.always%",
						"%config.localServerDownload.off%"
					],
					"markdownDescription": "%config.localServerDownload%"
				},
				"kasugai.remotePlatform": {
					"type": "object",
					"description": "%config.remotePlatform%",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "string",
						"enum": [
							"linux",
							"macos",
							"windows"
						]
					}
				},
				"kasugai.remoteServerListenOnSocket": {
					"type": "boolean",
					"description": "%config.remoteServerListenOnSocket%",
					"default": false
				},
				"kasugai.serverInstallPath": {
					"type": "object",
					"description": "%config.serverInstallPath%",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "string"
					}
				},
				"kasugai.serverBinaryName": {
					"type": "string",
					"description": "%config.serverBinaryName%",
					"scope": "application",
					"default": ""
				},
				"kasugai.serverVersion": {
					"type": "string",
					"description": "%config.serverVersion%",
					"scope": "application"
				},
				"kasugai.serverValidation": {
					"type": "string",
					"description": "%config.serverValidation%",
					"scope": "application",
					"enum": [
						"force",
						"skip",
						"strict"
					],
					"enumDescriptions": [
						"%config.serverValidation.force%",
						"%config.serverValidation.skip%",
						"%config.serverValidation.strict%"
					]
				},
				"kasugai.handleSshRemote": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"markdownDescription": "%config.handleSshRemote%"
				},
				"kasugai.updateCheck": {
					"type": "string",
					"enum": [
						"notify",
						"off"
					],
					"default": "notify",
					"scope": "application",
					"enumDescriptions": [
						"%config.updateCheck.notify%",
						"%config.updateCheck.off%"
					],
					"markdownDescription": "%config.updateCheck%"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "kasugai",
					"title": "Kasugai",
					"icon": "resources/activitybar.svg"
				}
			]
		},
		"views": {
			"kasugai": [
				{
					"id": "kasugaiHosts",
					"name": "%view.hosts.name%",
					"icon": "resources/activitybar.svg"
				},
				{
					"type": "webview",
					"id": "kasugaiFeedback",
					"name": "%view.feedback.name%",
					"icon": "resources/activitybar.svg"
				}
			]
		},
		"commands": [
			{
				"command": "kasugai.openEmptyWindow",
				"title": "%command.openEmptyWindow.title%",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.openEmptyWindowInCurrentWindow",
				"title": "%command.openEmptyWindowInCurrentWindow.title%",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.openConfigFile",
				"title": "%command.openConfigFile.title%",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.showLog",
				"title": "%command.showLog.title%",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.explorer.emptyWindowInNewWindow",
				"title": "%command.explorer.emptyWindowInNewWindow.title%",
				"icon": "$(empty-window)"
			},
			{
				"command": "kasugai.explorer.emptyWindowInCurrentWindow",
				"title": "%command.explorer.emptyWindowInCurrentWindow.title%",
				"icon": "$(arrow-right)"
			},
			{
				"command": "kasugai.explorer.reopenFolderInCurrentWindow",
				"title": "%command.explorer.reopenFolderInCurrentWindow.title%",
				"icon": "$(arrow-right)"
			},
			{
				"command": "kasugai.explorer.reopenFolderInNewWindow",
				"title": "%command.explorer.reopenFolderInNewWindow.title%",
				"icon": "$(folder-opened)"
			},
			{
				"command": "kasugai.explorer.deleteFolderHistoryItem",
				"title": "%command.explorer.deleteFolderHistoryItem.title%",
				"icon": "$(x)"
			},
			{
				"command": "kasugai.explorer.refresh",
				"title": "%command.explorer.refresh.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "kasugai.explorer.configure",
				"title": "%command.explorer.configure.title%",
				"icon": "$(gear)"
			},
			{
				"command": "kasugai.explorer.add",
				"title": "%command.explorer.add.title%",
				"icon": "$(plus)"
			},
			{
				"command": "kasugai.killServer",
				"title": "%command.killServer.title%",
				"category": "Kasugai"
			},
			{
				"command": "kasugai.reportIssue",
				"title": "%command.reportIssue.title%",
				"category": "Kasugai",
				"icon": "$(report)"
			},
			{
				"command": "kasugai.openRepository",
				"title": "%command.openRepository.title%",
				"category": "Kasugai",
				"icon": "$(github)"
			},
			{
				"command": "kasugai.sendFeedback",
				"title": "%command.sendFeedback.title%",
				"category": "Kasugai",
				"icon": "$(feedback)"
			},
			{
				"command": "kasugai.checkForUpdates",
				"title": "%command.checkForUpdates.title%",
				"category": "Kasugai"
			}
		],
		"resourceLabelFormatters": [
			{
				"scheme": "vscode-remote",
				"authority": "kasugai-ssh+*",
				"formatting": {
					"label": "${path}",
					"separator": "/",
					"tildify": true,
					"workspaceSuffix": "SSH"
				}
			}
		],
		"menus": {
			"statusBar/remoteIndicator": [
				{
					"command": "kasugai.openEmptyWindow",
					"when": "remoteName == kasugai-ssh && remoteConnectionState == connected || remoteName == ssh-remote && config.kasugai.handleSshRemote && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@1"
				},
				{
					"command": "kasugai.openEmptyWindowInCurrentWindow",
					"when": "remoteName == kasugai-ssh && remoteConnectionState == connected || remoteName == ssh-remote && config.kasugai.handleSshRemote && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@2"
				},
				{
					"command": "kasugai.openConfigFile",
					"when": "remoteName == kasugai-ssh && remoteConnectionState == connected || remoteName == ssh-remote && config.kasugai.handleSshRemote && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@3"
				},
				{
					"command": "kasugai.showLog",
					"when": "remoteName == kasugai-ssh && remoteConnectionState == connected || remoteName == ssh-remote && config.kasugai.handleSshRemote && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@4"
				},
				{
					"command": "kasugai.killServer",
					"when": "remoteName == kasugai-ssh && remoteConnectionState == connected || remoteName == ssh-remote && config.kasugai.handleSshRemote && remoteConnectionState == connected",
					"group": "remote_20_ssh_1general@5"
				},
				{
					"command": "kasugai.openEmptyWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@1"
				},
				{
					"command": "kasugai.openEmptyWindowInCurrentWindow",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@2"
				},
				{
					"command": "kasugai.openConfigFile",
					"when": "remoteConnectionState == disconnected",
					"group": "remote_20_ssh_3local@3"
				},
				{
					"command": "kasugai.openEmptyWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@5"
				},
				{
					"command": "kasugai.openEmptyWindowInCurrentWindow",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@6"
				},
				{
					"command": "kasugai.openConfigFile",
					"when": "!remoteName && !virtualWorkspace",
					"group": "remote_20_ssh_3local@7"
				}
			],
			"commandPalette": [
				{
					"command": "kasugai.explorer.refresh",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.configure",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.add",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.emptyWindowInNewWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.emptyWindowInCurrentWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.reopenFolderInCurrentWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.reopenFolderInNewWindow",
					"when": "false"
				},
				{
					"command": "kasugai.explorer.deleteFolderHistoryItem",
					"when": "false"
				},
				{
					"command": "kasugai.killServer",
					"when": "remoteName == kasugai-ssh || remoteName == ssh-remote && config.kasugai.handleSshRemote"
				}
			],
			"view/title": [
				{
					"command": "kasugai.explorer.add",
					"when": "view == kasugaiHosts",
					"group": "navigation"
				},
				{
					"command": "kasugai.explorer.configure",
					"when": "view == kasugaiHosts",
					"group": "navigation"
				},
				{
					"command": "kasugai.explorer.refresh",
					"when": "view == kasugaiHosts",
					"group": "navigation"
				},
				{
					"command": "kasugai.reportIssue",
					"when": "view == kasugaiHosts",
					"group": "kasugai@1"
				},
				{
					"command": "kasugai.openRepository",
					"when": "view == kasugaiHosts",
					"group": "kasugai@2"
				},
				{
					"command": "kasugai.checkForUpdates",
					"when": "view == kasugaiHosts",
					"group": "kasugai@3"
				},
				{
					"command": "kasugai.showLog",
					"when": "view == kasugaiFeedback",
					"group": "kasugai@1"
				},
				{
					"command": "kasugai.openRepository",
					"when": "view == kasugaiFeedback",
					"group": "kasugai@2"
				}
			],
			"view/item/context": [
				{
					"command": "kasugai.explorer.emptyWindowInCurrentWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.emptyWindowInNewWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.emptyWindowInNewWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "navigation@2"
				},
				{
					"command": "kasugai.explorer.emptyWindowInCurrentWindow",
					"when": "viewItem =~ /^kasugai.explorer.host$/",
					"group": "navigation@1"
				},
				{
					"command": "kasugai.explorer.reopenFolderInCurrentWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.reopenFolderInNewWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "inline@1"
				},
				{
					"command": "kasugai.explorer.reopenFolderInNewWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "navigation@2"
				},
				{
					"command": "kasugai.explorer.reopenFolderInCurrentWindow",
					"when": "viewItem == kasugai.explorer.folder",
					"group": "navigation@1"
				},
				{
					"command": "kasugai.explorer.deleteFolderHistoryItem",
					"when": "viewItem =~ /^kasugai.explorer.folder/",
					"group": "navigation@3"
				},
				{
					"command": "kasugai.explorer.deleteFolderHistoryItem",
					"when": "viewItem =~ /^kasugai.explorer.folder/",
					"group": "inline@2"
				}
			]
		}
	},
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"overrides": {
		"@azure/identity": {
			"@azure/msal-node": "7.1.1"
		},
		"@octokit/request": {
			"content-type": "2.1.0"
		},
		"get-uri": {
			"basic-ftp": "6.2.6"
		},
		"magicast": {
			"source-map-js": "1.2.2"
		},
		"postcss": {
			"source-map-js": "1.2.2"
		},
		"release-it": {
			"undici": "7.30.1"
		}
	},
	"allowScripts": {
		"fsevents": true
	},
	"keywords": [
		"kasugai",
		"reconnect",
		"remote",
		"remote development",
		"ssh",
		"vscodium"
	],
	"enabledApiProposals": [
		"resolvers",
		"contribViewsRemote"
	],
	"extensionKind": [
		"ui"
	],
	"l10n": "./l10n"
}
